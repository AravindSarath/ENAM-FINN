# Stage 0 needs no keys. Added at Stage 2/4:
GEMINI_API_KEY=
# Optional model overrides (defaults shown)
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_SMART_MODEL=gemini-3.5-flash
# Optional runtime cache (falls back to in-memory + committed data/cache)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Demo clock: ISO timestamp the digest windows are relative to (default = latest ingest)
FINN_AS_OF=
